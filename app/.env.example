# Copia este archivo como .env.local (o .env) y pon tu clave. Ese archivo no se sube a git.
# Sin clave, Higia funciona igual con el intérprete local (modo autónomo).
# IA: API de DeepSeek, modelo DeepSeek-V4.1-Flash (deepseek-flash). Las respuestas estructuradas se
# piden con una herramienta (function calling) forzada. Opcional: DEEPSEEK_BASE_URL.
DEEPSEEK_API_KEY=

# Voz local (opcional). Por defecto: Vosk en Brave/Firefox/Chromium y Web Speech en Chrome/Edge.
# VITE_VOSK_MOTOR=local       # fuerza Vosk (sin conexión) también en Chrome/Edge
# VITE_VOSK_MOTOR=navegador   # fuerza el reconocimiento del navegador
# VITE_VOSK_MODELO=/voz/vosk-model-es-0.42.tar.gz   # otro modelo (ver npm run voz:modelo)
